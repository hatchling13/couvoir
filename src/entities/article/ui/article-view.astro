---
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { title, description, date, tags } = Astro.props;
---

<article>
  <header>
    <h1>{title}</h1>
    <p>{description}</p>
    <time datetime={date.toISOString()}>{date.toLocaleDateString("ko-KR")}</time>
  </header>

  <section aria-label="본문">
    <slot />
  </section>

  {
    tags.length > 0 && (
      <footer>
        <ul aria-label="태그">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </footer>
    )
  }
</article>
