---
import "katex/dist/katex.min.css";
import { localeText, type Locale } from "@shared/config/i18n";
import * as styles from "./article-view.styles";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  locale: Locale;
}

const { title, description, date, tags, locale } = Astro.props;
const text = localeText[locale];
const displayDate = date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<article class={styles.article}>
  <header class={styles.header}>
    <h1 class={styles.title}>{title}</h1>
    <p class={styles.description}>{description}</p>
    <time class={styles.date} datetime={date.toISOString()}>
      {displayDate}
    </time>
  </header>

  <section class={styles.body} aria-label={text.articleBody}>
    <slot />
  </section>

  {
    tags.length > 0 && (
      <footer class={styles.footer}>
        <ul class={styles.tags} aria-label={text.tags}>
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </footer>
    )
  }
</article>
