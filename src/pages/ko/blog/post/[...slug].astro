---
import { ArticleView, getArticleSlug, getArticles } from "@entities/article";
import { SiteShell } from "@widgets/site-shell";
import {
  render,
  type CollectionEntry,
} from "astro:content";

export async function getStaticPaths() {
  const locale = "ko";
  const entries = await getArticles("post", locale);

  return entries.map((entry) => ({
    params: { slug: getArticleSlug(entry, locale) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"post">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, taxonomies } = entry.data;
---

<SiteShell title={title} description={description}>
  <ArticleView
    title={title}
    description={description}
    date={date}
    tags={taxonomies.tags}
    locale="ko"
  >
    <Content />
  </ArticleView>
</SiteShell>
