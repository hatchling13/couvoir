---
import { getArticleSummaries, type ArticleSummary } from "@entities/article";
import { localeText } from "@shared/config/i18n";
import { visuallyHidden } from "@shared/styles/common";
import {
  articleColumns,
  ArticleNavigation,
  ArticlePagination,
  ArticleSection,
} from "@widgets/article-list";
import { SiteShell } from "@widgets/site-shell";
import type { GetStaticPaths, Page } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export const getStaticPaths = (async ({ paginate }) => {
  const locale = "ko";
  const articles = await getArticleSummaries("retrospect", locale);

  return paginate(articles, { pageSize: 8 });
}) satisfies GetStaticPaths;

const locale = "ko";

interface Props {
  page: Page<ArticleSummary>;
}

const { page } = Astro.props;
const text = localeText[locale];
---

<SiteShell title={text.retrospects} description="회고 목록.">
  <h1 class={visuallyHidden}>blog — retrospects</h1>
  <ArticleNavigation locale={locale} activeCollection="retrospect" />
  <div class={articleColumns({ single: true })}>
    <ArticleSection
      title="retrospects"
      articles={page.data}
      totalCount={page.total}
      locale={locale}
    >
      <ArticlePagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        basePath={getRelativeLocaleUrl(locale, "blog/retrospect")}
        locale={locale}
      />
    </ArticleSection>
  </div>
</SiteShell>
