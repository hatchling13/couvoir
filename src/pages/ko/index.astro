---
import { pageBody } from "@shared/styles/common";
import { GalleryPreview } from "@widgets/gallery-preview";
import { HomeIntroduction } from "@widgets/home-introduction";
import { InterestExplorer } from "@widgets/interest-explorer";
import { SiteShell } from "@widgets/site-shell";
---

<SiteShell
  title="Couvoir = f(projects)(blog)(me)"
  description="그냥 뭐 이것저것"
>
  <HomeIntroduction locale="ko" />
  <InterestExplorer locale="ko" label="관심사" quoteLabel="인용문" />
  {
    import.meta.env.DEV && (
      <div class={pageBody}>
        <GalleryPreview locale="ko" />
      </div>
    )
  }
</SiteShell>
