---
import { getArticleSummaries, type ArticleSummary } from "@entities/article";
import { localeText } from "@shared/config/i18n";
import { visuallyHidden } from "@shared/styles/common";
import {
  articleColumns,
  ArticleNavigation,
  ArticlePagination,
  ArticleSection,
} from "@widgets/article-list";
import { SiteShell } from "@widgets/site-shell";
import type { GetStaticPaths, Page } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export const getStaticPaths = (async ({ paginate }) => {
  const locale = "en";
  const articles = await getArticleSummaries("post", locale);

  return articles.length > 0 ? paginate(articles, { pageSize: 8 }) : [];
}) satisfies GetStaticPaths;

const locale = "en";

interface Props {
  page: Page<ArticleSummary>;
}

const { page } = Astro.props;
const text = localeText[locale];
---

<SiteShell title={text.posts} description="Post archive.">
  <h1 class={visuallyHidden}>blog — posts</h1>
  <ArticleNavigation
    locale={locale}
    activeCollection="post"
    availableCollections={["post"]}
  />
  <div class={articleColumns({ single: true })}>
    <ArticleSection
      title="posts"
      articles={page.data}
      totalCount={page.total}
      locale={locale}
    >
      <ArticlePagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        basePath={getRelativeLocaleUrl(locale, "blog/post")}
        locale={locale}
      />
    </ArticleSection>
  </div>
</SiteShell>
