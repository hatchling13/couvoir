---
import { getArticleSummaries, type ArticleSummary } from "@entities/article";
import { localeText } from "@shared/config/i18n";
import { visuallyHidden } from "@shared/styles/common";
import {
  articleColumns,
  ArticleNavigation,
  ArticlePagination,
  ArticleSection,
} from "@widgets/article-list";
import { SiteShell } from "@widgets/site-shell";
import type { GetStaticPaths, Page } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export const getStaticPaths = (async ({ paginate }) => {
  const locale = "en";
  const articles = await getArticleSummaries("retrospect", locale);

  return articles.length > 0 ? paginate(articles, { pageSize: 8 }) : [];
}) satisfies GetStaticPaths;

const locale = "en";

interface Props {
  page: Page<ArticleSummary>;
}

const { page } = Astro.props;
const text = localeText[locale];
---

<SiteShell
  title={`blog = b(posts)(retrospects) — ${text.retrospects} · ${page.currentPage}`}
  description="Retrospect archive."
>
  <h1 class={visuallyHidden}>blog — retrospects</h1>
  <ArticleNavigation
    locale={locale}
    activeCollection="retrospect"
    availableCollections={["retrospect"]}
  />
  <div class={articleColumns({ single: true })}>
    <ArticleSection
      title="retrospects"
      articles={page.data}
      totalCount={page.total}
      locale={locale}
    >
      <ArticlePagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        basePath={getRelativeLocaleUrl(locale, "blog/retrospect")}
        locale={locale}
      />
    </ArticleSection>
  </div>
</SiteShell>
