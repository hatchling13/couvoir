---
import { css } from "@styled-system/css";
import { SiteShell } from "@widgets/site-shell";

const contentStyles = css({
  minH: "full",
  px: "6",
  py: "24",
  display: "grid",
  placeItems: "center",
  textAlign: "center",
});

const headingStyles = css({
  fontSize: { base: "5xl", md: "7xl" },
  fontWeight: "bold",
  letterSpacing: "tight",
});
---

<SiteShell
  title="Couvoir"
  description="A personal playground for works, writing, and experiments."
>
  <section class={contentStyles}>
    <h1 class={headingStyles}>Couvoir</h1>
  </section>
</SiteShell>
