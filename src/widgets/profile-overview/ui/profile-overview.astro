---
import { css } from "@styled-system/css";
import * as styles from "./profile-overview.styles";

interface Props {
  name: string;
  occupation: string;
  contactsLabel: string;
  cvHref: string;
}

const { name, occupation, contactsLabel, cvHref } = Astro.props;

const contacts = [
  {
    label: "Email",
    href: "mailto:me@hatchling.dev",
    content: "me@hatchling.dev",
  },
  {
    label: "GitHub",
    href: "https://github.com/hatchling13",
    content: "hatchling13",
  },
  {
    label: "Bluesky",
    href: "https://bsky.app/profile/hatchling.dev",
    content: "@hatchling.dev",
  },
  {
    label: "Hackers' Pub",
    href: "https://hackers.pub/@hatchling13",
    content: "@hatchling13",
  },
];
---

<section class={styles.profile} aria-labelledby="profile-heading">
  <header>
    <h1 class={styles.name} id="profile-heading">{name}</h1>
    <p class={styles.role}>{occupation}</p>
  </header>
  <div class={styles.details}>
    <address class={css({ fontStyle: "normal" })} aria-label={contactsLabel}>
      <ul class={styles.contacts}>
        {
          contacts.map(({ label, href, content }) => (
            <li class={styles.contact}>
              <span class={styles.label}>{label.toLowerCase()}</span>
              <a class={styles.link} href={href}>
                {content}
              </a>
            </li>
          ))
        }
      </ul>
    </address>
    <div class={styles.document}>
      <span class={styles.label}>document</span>
      <a class={styles.documentName} href={cvHref}>curriculum-vitae</a>
    </div>
  </div>
</section>
