---
import type { ArticleSummary } from "@entities/article";
import type { Locale } from "@shared/config/i18n";
import ArticleList from "./article-list.astro";
import {
  archiveLink,
  articleCount,
  sectionHeader,
  sectionHeading,
} from "./article-section.styles";

interface Props {
  title: string;
  articles: ArticleSummary[];
  moreHref?: string;
  totalCount?: number;
  locale: Locale;
}

const { title, articles, moreHref, totalCount, locale } = Astro.props;
---

<section aria-labelledby={`${title}-heading`}>
  <header class={sectionHeader}>
    <h2 class={sectionHeading} id={`${title}-heading`}>{title}</h2>
    {
      moreHref && articles.length > 0 ? (
        <a class={archiveLink} href={moreHref}>
          archive
        </a>
      ) : totalCount !== undefined ? (
        <span class={articleCount}>{totalCount} entries</span>
      ) : null
    }
  </header>
  <ArticleList articles={articles} locale={locale} headingLevel={3} />
  <slot />
</section>
