---
import { localeText, type Locale } from "@shared/config/i18n";

interface Props {
  currentPage: number;
  lastPage: number;
  basePath: string;
  locale: Locale;
}

const { currentPage, lastPage, basePath, locale } = Astro.props;
const text = localeText[locale];
const pageNumbers = Array.from({ length: lastPage }, (_, index) => index + 1);
const normalizedBasePath = basePath.replace(/\/+$/, "");
const pageHref = (page: number) => `${normalizedBasePath}/${page}`;
---

{
  lastPage > 1 && (
    <nav aria-label={text.pagination}>
      {currentPage > 1 && (
        <a href={pageHref(currentPage - 1)}>{text.previousPage}</a>
      )}
      <ol>
        {pageNumbers.map((page) => (
          <li>
            {page === currentPage ? (
              <span aria-current="page">{page}</span>
            ) : (
              <a href={pageHref(page)}>{page}</a>
            )}
          </li>
        ))}
      </ol>
      {currentPage < lastPage && (
        <a href={pageHref(currentPage + 1)}>{text.nextPage}</a>
      )}
    </nav>
  )
}
