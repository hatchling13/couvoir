---
import { localeText, type Locale } from "@shared/config/i18n";
import * as styles from "./article-pagination.styles";

interface Props {
  currentPage: number;
  lastPage: number;
  basePath: string;
  locale: Locale;
}

const { currentPage, lastPage, basePath, locale } = Astro.props;
const text = localeText[locale];
const pageNumbers = Array.from({ length: lastPage }, (_, index) => index + 1);
const normalizedBasePath = basePath.replace(/\/+$/, "");
const pageHref = (page: number) => `${normalizedBasePath}/${page}`;
---

{
  lastPage > 1 && (
    <nav class={styles.pagination} aria-label={text.pagination}>
      {currentPage > 1 ? (
        <a
          class={styles.link}
          href={pageHref(currentPage - 1)}
          aria-label={text.previousPage}
        >
          previous
        </a>
      ) : (
        <span class={styles.placeholder}>previous</span>
      )}
      <ol class={styles.pages}>
        {pageNumbers.map((page) => (
          <li>
            {page === currentPage ? (
              <span class={styles.current} aria-current="page">
                {String(page).padStart(2, "0")}
              </span>
            ) : (
              <a class={styles.link} href={pageHref(page)}>
                {String(page).padStart(2, "0")}
              </a>
            )}
          </li>
        ))}
      </ol>
      {currentPage < lastPage ? (
        <a
          class:list={[styles.link, styles.next]}
          href={pageHref(currentPage + 1)}
          aria-label={text.nextPage}
        >
          next
        </a>
      ) : (
        <span class:list={[styles.next, styles.placeholder]}>next</span>
      )}
    </nav>
  )
}
