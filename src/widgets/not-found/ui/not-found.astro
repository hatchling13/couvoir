---
import { getLocale } from "@shared/config/i18n";
import { pageHeading, pageTitle } from "@shared/styles/common";
import { css } from "@styled-system/css";
import { SiteShell } from "@widgets/site-shell";

const locale = getLocale(Astro.currentLocale);
const translations = {
  ko: {
    title: "페이지를 찾을 수 없습니다.",
    description:
      "주소가 올바른지 확인하거나, 홈 또는 블로그에서 다시 찾아보세요.",
    home: "홈으로",
    blog: "블로그 보기",
  },
  en: {
    title: "Page not found.",
    description:
      "Check the address, or find your way from the homepage or blog.",
    home: "Go home",
    blog: "Browse the blog",
  },
} as const;
const text = translations[locale];

const recoveryLink = css({
  display: "inline-block",
  paddingY: "2",
  textDecoration: "underline",
  textDecorationColor: "rule",
  textUnderlineOffset: "token(spacing.1)",
  _hover: { textDecorationColor: "ink" },
});
---

<SiteShell title={`404 — ${text.title}`} description={text.description} noindex>
  <div class={pageHeading}>
    <h1 class={pageTitle}>404</h1>
  </div>
  <section class={css({ marginTop: "8" })} aria-labelledby="not-found-heading">
    <h2
      id="not-found-heading"
      class={css({
        margin: "0",
        fontSize: "xl",
        fontWeight: "semibold",
        lineHeight: "relaxed",
      })}
    >
      {text.title}
    </h2>
    <p
      class={css({
        marginTop: "3",
        marginBottom: "0",
        color: "muted",
        lineHeight: "relaxed",
      })}
    >
      {text.description}
    </p>
    <div
      class={css({
        display: "flex",
        flexWrap: "wrap",
        columnGap: "6",
        rowGap: "2",
        marginTop: "3",
      })}
    >
      <a class={recoveryLink} href={`/${locale}/`}>
        {text.home}
      </a>
      <a class={recoveryLink} href={`/${locale}/blog/`}>
        {text.blog}
      </a>
    </div>
  </section>
</SiteShell>
