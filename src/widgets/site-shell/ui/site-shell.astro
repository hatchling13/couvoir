---
import { getLocale } from "@shared/config/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import SiteFooter from "./site-footer.astro";
import SiteNavigation from "./site-navigation.astro";
import { masthead, siteMain, sitePage, skipLink } from "./site-shell.styles";
import "@shared/styles/global.css";
import { renderSiteHead, type ArticleMetadata } from "../model/site-head";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  article?: ArticleMetadata;
}

const { title, description, noindex, article } = Astro.props;

const locale = getLocale(Astro.currentLocale);
if (!Astro.site) throw new Error("Astro site URL is required for metadata.");
const headTags = renderSiteHead({
  title,
  description,
  site: Astro.site,
  pathname: Astro.url.pathname,
  locale,
  noindex,
  article,
});
const skipLabel = locale === "ko" ? "본문으로 건너뛰기" : "Skip to content";
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Fragment set:html={headTags} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Couvoir RSS"
      href={getRelativeLocaleUrl(locale, "rss.xml")}
    />
    <slot name="head" />
  </head>
  <body>
    <a class={skipLink} href="#main-content">{skipLabel}</a>
    <div class={sitePage}>
      <header class={masthead}>
        <SiteNavigation />
      </header>
      <main class={siteMain} id="main-content">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
