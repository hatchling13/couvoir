---
import { getRelativeLocaleUrl } from "astro:i18n";
import * as styles from "./site-navigation.styles";

const locales = ["ko", "en"] as const;
type Locale = (typeof locales)[number];

const currentLocale = locales.includes(Astro.currentLocale as Locale)
  ? (Astro.currentLocale as Locale)
  : "ko";
const navigationLabel = currentLocale === "ko" ? "주요 메뉴" : "Primary";

const links = [
  { path: "projects", label: "projects" },
  { path: "blog", label: "blog" },
  { path: "me", label: "me" },
].map(({ path, label }) => ({
  href: getRelativeLocaleUrl(currentLocale, path),
  label,
}));

const homeHref = getRelativeLocaleUrl(currentLocale, "");

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const localeRoot = normalizePath(homeHref);

const isCurrentPage = (href: string) => {
  const linkPath = normalizePath(href);

  return linkPath === localeRoot
    ? currentPath === localeRoot
    : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
};
const hasActiveSection = links.some(({ href }) => isCurrentPage(href));
---

<nav class={styles.navigation} aria-label={navigationLabel}>
  <a
    class={styles.brand}
    href={homeHref}
    aria-current={isCurrentPage(homeHref) ? "page" : undefined}>Couvoir</a
  >
  <span class={styles.notation} aria-hidden="true">
    <span>=</span>
    <span>𝑓</span>
  </span>
  {
    links.map(({ href, label }) => (
      <a
        class={styles.route}
        data-dimmed={String(hasActiveSection && !isCurrentPage(href))}
        href={href}
        aria-current={isCurrentPage(href) ? "page" : undefined}
      >
        <span aria-hidden="true">(</span>
        <span>{label}</span>
        <span aria-hidden="true">)</span>
      </a>
    ))
  }
</nav>
