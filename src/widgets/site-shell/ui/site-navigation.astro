---
import { getRelativeLocaleUrl } from "astro:i18n";

const locales = ["ko", "en"] as const;
type Locale = (typeof locales)[number];

const currentLocale = locales.includes(Astro.currentLocale as Locale)
  ? (Astro.currentLocale as Locale)
  : "ko";
const navigationLabel = currentLocale === "ko" ? "주요 메뉴" : "Primary";

const links = [
  { path: "", label: "Couvoir" },
  { path: "playground", label: "Playground" },
  { path: "me", label: "Me" },
  { path: "blog", label: "Blog" },
].map(({ path, label }) => ({
  href: getRelativeLocaleUrl(currentLocale, path),
  label,
}));

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const localeRoot = normalizePath(getRelativeLocaleUrl(currentLocale));

const isCurrentPage = (href: string) => {
  const linkPath = normalizePath(href);

  return linkPath === localeRoot
    ? currentPath === localeRoot
    : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
};
---

<nav aria-label={navigationLabel}>
  <ul>
    {
      links.map(({ href, label }) => {
        const isCurrent = isCurrentPage(href);

        return (
          <li>
            <a href={href} aria-current={isCurrent ? "page" : undefined}>
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
