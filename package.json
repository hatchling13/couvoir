{
  "name": "couvoir",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "astro dev --background",
    "build": "astro build",
    "deploy": "wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt:astro": "prettier --write \"src/**/*.astro\" --plugin=prettier-plugin-astro",
    "fmt:astro:check": "prettier --check \"src/**/*.astro\" --plugin=prettier-plugin-astro",
    "check": "astro check && oxlint"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "katex": "^0.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-shift-heading": "^2.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "takumi-js": "^2.13.7",
    "unhead": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pandacss/dev": "^1.12.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
